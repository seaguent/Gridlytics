{
  "manifest_version": 3,
  "name": "Gridlytics",
  "version": "0.1.0",
  "description": "Fantasy football analytics for Sleeper leagues",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8001/*", "https://gridlytics-production.up.railway.app/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://sleeper.com/leagues/*", "https://sleeper.app/leagues/*"],
      "js": ["content.js"]
    }
  ]
}
